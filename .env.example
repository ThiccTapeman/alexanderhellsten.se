# Server-only. Never prefix these with NEXT_PUBLIC_.
# Use your provider's pooled PostgreSQL connection URL with TLS.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=verify-full
# Exact origin allowed to submit admin requests. Use http://localhost:3000 in dev.
APP_ORIGIN=https://alexanderhellsten.se
