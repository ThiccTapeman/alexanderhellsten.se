# Server-only. Never prefix these with NEXT_PUBLIC_.
# Use your provider's pooled PostgreSQL connection URL with TLS.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=verify-full
# Exact origin allowed to submit admin requests. Use http://localhost:3000 in dev.
APP_ORIGIN=https://alexanderhellsten.se
# Optional PEM CA certificate when your database uses a private certificate authority.
# DATABASE_CA=

# Contact form email delivery (server-only).
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=YOUR_BREVO_SMTP_LOGIN
SMTP_PASS=YOUR_BREVO_SMTP_KEY
# Must be a verified sender or use an authenticated domain in Brevo.
FROM_EMAIL=contact@alexanderhellsten.se
TO_EMAIL=alexanderhellsten7@gmail.com
